<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>name.sam12three.nbplugin</groupId>
    <artifactId>sys-properties</artifactId>
    <version>2.0.3-SNAPSHOT</version>
    <packaging>nbm</packaging>
    
    <name>sys-properties</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <netbeans.version>RELEASE270</netbeans.version>
        <!--Required property so that the context menu "Install/Reload in Development IDE" may install the plugin inside it-->
        <netbeans.installation>/Users/samsharaf/platform-release28/netbeans/nbbuild/netbeans</netbeans.installation>
        <!--Has to pass the regex "[a-z][a-z0-9]*(_[a-z][a-z0-9]*)*"-->
        <!--Could be passed via the command line as -Dnetbeans.branding.token-->
        <brandingToken>sysproperties</brandingToken>
        <nbm.homepage></nbm.homepage>
        <nbm.module.author>Maintainer is Sam Sharaf</nbm.module.author>
        <proguard.version>7.2.2</proguard.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-netbeans-api-annotations-common</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-openide-util</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-openide-util-lookup</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-netbeans-modules-java-project</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <!-- ======= All the below are already declared transitively, but listed directly to get rid of the IDE warning ======== -->
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-netbeans-modules-editor</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-netbeans-modules-autoupdate-services</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-netbeans-api-progress</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-openide-dialogs</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-openide-awt</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-netbeans-modules-projectuiapi</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--The build stops in nbm:manifest because the plugin’s runtime verifier cannot match the classes it finds in target/classes with the NetBeans modules declared in your pom.xml (pom.xml (line 12) sets netbeans.version=RELEASE270).
            Those classes (HelpCtx, ClassIndex, ClasspathInfo, SourceUtils, ElementHandle) really come from org.openide.dialogs and org-netbeans-modules-java-source, and both dependencies are on your classpath—the debug log even lists them.
            The problem is that the RELEASE270 artifacts published to Maven Central (NetBeans 27 snapshot) do not yet ship the metadata the verifier relies on (the same situation referenced by Jira ticket MNBMODULE-102). Without that catalog, the plugin thinks the classes are missing and fails the build even though the jars are present.-->
            <!-- Temporarily disable the verifier by adding <verifyRuntime>skip</verifyRuntime> under the org.apache.netbeans.utilities:nbm-maven-plugin configuration—your module already depends on the right jars, so skipping the broken check is safe as a short-term workaround.-->
            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <artifactId>nbm-maven-plugin</artifactId>
                <version>14.4</version>
                <extensions>true</extensions>
                <configuration>
                    <verifyRuntime>skip</verifyRuntime>
                    <author>${nbm.module.author}</author>
                    <homePageUrl>${nbm.homepage}</homePageUrl>
                    <moduleType>normal</moduleType>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <!--Not needed in this project whose layer.xml can not be migrated to annotations. But leave it for future reference-->
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.netbeans.api</groupId>
                            <artifactId>org-openide-util-lookup</artifactId>
                            <version>${netbeans.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>${proguard.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>shrink-and-optimize</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                        <configuration>
                            <proguardVersion>${proguard.version}</proguardVersion>
                            <injar>${project.build.finalName}.jar</injar>
                            <outjar>${project.build.finalName}.jar</outjar>
                            <skip>false</skip>
                            <mappingFileName>mapping.txt</mappingFileName>
                            <libs>
                                <!-- ProGuard 7.2.x only understands up to Java 18 class files,
                                so run the build with JAVA_HOME pointing at a JDK 17 (or
                                earlier) and expose its java.base module here. -->
                                <lib>${java.home}/jmods/java.base.jmod</lib>
                            </libs>
                            <options>
                                <option>-include ${project.basedir}/src/main/proguard/sys-properties.pro</option>
                                <option>-keepattributes *Annotation*,InnerClasses,EnclosingMethod,Signature,SourceFile,LineNumberTable</option>
                                <option>-dontwarn org.netbeans.**</option>
                                <option>-dontwarn org.openide.**</option>
                                <option>-dontwarn java.**</option>
                                <option>-dontwarn javax.**</option>
                                <option>-dontwarn jdk.**</option>
                                <option>-dontwarn sun.**</option>
                                <option>-ignorewarnings</option>
                                <option>-dontnote</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <!-- From the Project context menu hit: mvn clean install then create new action: nbm:cluster nbm:run-ide or use one of the 2 below profiles-->
            <id>point-to-platform</id>
            <properties>
                <!--The root folder of a Netbeans running IDE so that nbm:run-ide would find it or to load the plugin inside it-->
                <netbeans.installation>/Users/samsharaf/platform-release28/netbeans/nbbuild/netbeans</netbeans.installation>
            </properties>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
        <profile>
            <!-- From the Project context menu hit: Set Configuration-> run-nbm-forDevelopment. 
            Then From the Project context menu hit: Clean and Build-->
            <id>run-nbm-forDevelopment</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.netbeans.utilities</groupId>
                        <artifactId>nbm-maven-plugin</artifactId>
                        <version>14.4</version>
                        <extensions>true</extensions>
                        <configuration>
                            <verifyRuntime>skip</verifyRuntime>
                            <moduleType>normal</moduleType>
                        </configuration>
                        <executions>
                            <execution>
                                <id>run-npm-goals-after-install</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>cluster</goal>
                                    <goal>autoupdate</goal>
                                    <goal>run-ide</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- From the Project context menu hit: Set Configuration-> package-nbm-toRelease. 
            Then From the Project context menu hit: Clean and Build-->
            <id>package-nbm-toRelease</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.netbeans.utilities</groupId>
                        <artifactId>nbm-maven-plugin</artifactId>
                        <version>14.4</version>
                        <extensions>true</extensions>
                        <configuration>
                            <verifyRuntime>skip</verifyRuntime>
                            <author>${nbm.module.author}</author>
                            <homePageUrl>${nbm.homepage}</homePageUrl>
                            <moduleType>normal</moduleType>
                        </configuration>
                        <executions>
                            <execution>
                                <id>package-npm-goals-after-install</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>cluster</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    <repositories>
        <repository>
            <id>netbeans</id>
            <name>Apache NetBeans</name>
            <url>https://repository.apache.org/content/repositories/snapshots/</url>
        </repository>
    </repositories>
</project>
